# ===========================================================================
# LLM PROVIDERS — Multi-Tier Cross-Provider Orchestration & Multi-Key Pools
# ===========================================================================
# Configure as many providers and keys as you like. Every provider with at least one key
# becomes a tier. Default tier order (fastest first, universal fail-safe last):
#   groq -> cerebras -> mistral -> gemini -> openrouter -> openai -> custom
#
# Keys per provider, in any combination (unlimited numbered keys):
#   <P>_API_KEY=k1   <P>_API_KEY_2=k2   <P>_API_KEY_3=k3 ...   or   <P>_API_KEYS=k1,k2,k3
# Optional proactive per-key budgets (requests / tokens per minute, per model):
#   <P>_RPM=30   <P>_TPM=8000      (0 or "off" disables; defaults are conservative free-tier values)

# --- Tier 1: Groq (LPU, lowest latency) — https://console.groq.com -------------------------
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_RPM=30
# Free-tier TPM per model is small; budgeting it lets oversized deep-agent prompts skip Groq
# instantly instead of round-tripping a 413. Raise or set 0 on a paid plan.
GROQ_TPM=8000

# --- Tier 2: Cerebras (very fast, generous free tier) — https://cloud.cerebras.ai ----------
CEREBRAS_API_KEY=
# CEREBRAS_API_KEY_2=

# --- Tier 3: Mistral (high TPM) — https://console.mistral.ai ---------------------------------
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=

# --- Tier 4: Google Gemini (large free quotas) — https://aistudio.google.com ----------------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# GEMINI_RPM=10

# --- Tier 5: OpenRouter (universal fail-safe) — https://openrouter.ai ----------------------
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=

# --- Tier 6: OpenAI (paid) ------------------------------------------------------------------
OPENAI_API_KEY=

# --- Tier 7 (optional): any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, Together) --
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_FAST_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# --- Optional: explicit model chains (override the auto-built tier chains) -------------------
# Format: provider:model, comma-separated, tried in order. Only the first ":" splits.
# LLM_CHAIN_MAIN=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,cerebras:gpt-oss-120b,gemini:gemini-flash-latest,openrouter:meta-llama/llama-3.3-70b-instruct
# LLM_CHAIN_FAST=groq:llama-3.1-8b-instant,cerebras:llama3.1-8b,gemini:gemini-flash-lite-latest

# --- Router behaviour --------------------------------------------------------------------------
LLM_MAX_WAIT_SECONDS=45          # longest the router will wait when EVERY key is saturated
LLM_COOLDOWN_BASE_SECONDS=20     # first 429 cooldown when no Retry-After header (doubles, capped)
LLM_COOLDOWN_MAX_SECONDS=300
LLM_TEMPERATURE=0.1
# function_calling works on every provider in the registry
LLM_STRUCTURED_METHOD=function_calling

# ===========================================================================
# SEARCH — Tavily (multi-key pool, same rotation rules) — https://tavily.com
# ===========================================================================
TAVILY_API_KEY=tvly-your_key_1
# TAVILY_API_KEY_2=tvly-your_key_2
TAVILY_RPM=100
TAVILY_SEARCH_DEPTH=basic
SEARCH_RESULTS_PER_QUERY=5

# ===========================================================================
# AGENT BEHAVIOUR
# ===========================================================================
# "deep" = deepagents harness (planning + sub-agents); "react" = lightweight langchain create_agent
RESEARCH_ENGINE=deep
MAX_ITERATIONS=4
MAX_CLARIFICATION_ROUNDS=2
MAX_SCRAPES_PER_ITERATION=4
SCRAPE_RELEVANCE_THRESHOLD=0.5
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_MAX_CHARS=12000
