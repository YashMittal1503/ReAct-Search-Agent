# ===========================================================================
# LLM PROVIDERS — Multi-Tier Cross-Provider Orchestration & Multi-Key Pools
# ===========================================================================
# Configure as many providers and keys as you like. Every provider with at least one key
# becomes a tier. Default tier order (fastest first, universal fail-safe last):
#   groq -> cerebras -> mistral -> gemini -> openrouter -> openai -> custom
#
# Keys per provider, in any combination (unlimited numbered keys):
#   <P>_API_KEY=k1   <P>_API_KEY_2=k2   <P>_API_KEY_3=k3 ...   or   <P>_API_KEYS=k1,k2,k3
# Optional proactive per-key budgets, tracked per model (0 or "off" disables):
#   <P>_RPM=30         requests per minute
#   <P>_TPM=8000       tokens per minute for ALL models of the provider (overrides built-in per-model values)
#   <P>_CONTEXT=8192   max tokens per request; larger requests skip the provider without a call
# Per-model overrides (highest precedence; value after the last "="):
#   LLM_MODEL_TPM=groq:llama-3.3-70b-versatile=12000,groq:openai/gpt-oss-120b=8000
#   LLM_MODEL_CONTEXT=cerebras:gpt-oss-120b=8192

# --- Tier 1: Groq (LPU, lowest latency) — https://console.groq.com -------------------------
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_RPM=30
# Groq enforces TPM per model. Built-in free-tier defaults: gpt-oss-120b 8k, llama-3.3-70b 12k,
# llama-3.1-8b 6k, qwen3-32b 6k. Leave GROQ_TPM unset to use them; setting it applies ONE value
# to every Groq model. On a paid plan: GROQ_TPM=0 (or per-model values via LLM_MODEL_TPM).
# GROQ_TPM=

# --- Tier 2: Cerebras (very fast, generous free tier) — https://cloud.cerebras.ai ----------
CEREBRAS_API_KEY=
# CEREBRAS_API_KEY_2=
# Free tier caps requests at ~8k tokens (built-in default). On a paid plan: CEREBRAS_CONTEXT=0
# CEREBRAS_CONTEXT=8192

# --- Tier 3: Mistral (high TPM) — https://console.mistral.ai ---------------------------------
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=

# --- Tier 4: Google Gemini (large free quotas) — https://aistudio.google.com ----------------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# GEMINI_RPM=10

# --- Tier 5: OpenRouter (universal fail-safe) — https://openrouter.ai ----------------------
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=

# --- Tier 6: OpenAI (paid) ------------------------------------------------------------------
OPENAI_API_KEY=

# --- Tier 7 (optional): any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, Together) --
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_FAST_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# --- Optional: explicit model chains (override the auto-built tier chains) -------------------
# Format: provider:model, comma-separated, tried in order. Only the first ":" splits.
# LLM_CHAIN_MAIN=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,cerebras:gpt-oss-120b,gemini:gemini-flash-latest,openrouter:meta-llama/llama-3.3-70b-instruct
# LLM_CHAIN_FAST=groq:llama-3.1-8b-instant,cerebras:llama3.1-8b,gemini:gemini-flash-lite-latest

# --- Router behaviour --------------------------------------------------------------------------
LLM_MAX_WAIT_SECONDS=45          # longest the router will wait when EVERY key is saturated
LLM_COOLDOWN_BASE_SECONDS=20     # first 429 cooldown when no Retry-After header (doubles, capped)
LLM_COOLDOWN_MAX_SECONDS=300
LLM_TEMPERATURE=0.1
# function_calling works on every provider in the registry
LLM_STRUCTURED_METHOD=function_calling

# ===========================================================================
# SEARCH — Tavily (multi-key pool, same rotation rules) — https://tavily.com
# ===========================================================================
TAVILY_API_KEY=tvly-your_key_1
# TAVILY_API_KEY_2=tvly-your_key_2
TAVILY_RPM=100
TAVILY_SEARCH_DEPTH=basic
SEARCH_RESULTS_PER_QUERY=5

# ===========================================================================
# AGENT BEHAVIOUR
# ===========================================================================
# "deep" = deepagents harness (planning + sub-agents); "react" = lightweight langchain create_agent
RESEARCH_ENGINE=deep
MAX_ITERATIONS=4
MAX_CLARIFICATION_ROUNDS=2
MAX_SCRAPES_PER_ITERATION=4
SCRAPE_RELEVANCE_THRESHOLD=0.5
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_MAX_CHARS=12000

# ===========================================================================
# OBSERVABILITY
# ===========================================================================
# Local, always on: rotating JSON-lines app log + one JSONL file per run + a cross-run index.
LOG_DIR=logs                 # logs/app.jsonl, logs/runs/<date>/<run_id>.jsonl, logs/runs/index.jsonl
LOG_LEVEL=INFO
RUN_LOGS=true

# LangSmith (hosted tracing + evaluation feedback) — https://smith.langchain.com
# Tracing turns on automatically when LANGSMITH_API_KEY is set; LANGSMITH_TRACING=false turns it off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only

# ===========================================================================
# EXPERIMENT #19 — post-retrieval RAG (only used when SYNTHESIS_MODE=rag)
# ===========================================================================
# SYNTHESIS_MODE=two_step        # two_step (default) | single_step | rag
# RAG_CHUNK_CHARS=900
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=4                    # chunks kept per researched facet
# RAG_NEIGHBORS=1                # adjacent chunks added for context
# RAG_BUDGET_CHARS=12000         # max passage characters sent to the synthesizer
# RAG_EMBEDDINGS=auto            # auto = BM25 + local embeddings (RRF) | off = BM25 only
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # ~70 MB, downloaded once by fastembed
